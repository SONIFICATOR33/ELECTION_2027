rules_version = '2';
// Règles d'accès de la base « Les pronos des membrés ».
// À coller dans la console Firebase : Firestore > Règles > Publier.
// Les pronos et gouvernements enregistrés sont visibles par tous les joueurs connectés.
service cloud.firestore {
  match /databases/{db}/documents {

    // Dates en millisecondes (heure de Paris), identiques à js/data.js
    function T0()     { return 1795388400000; } // lundi 23 nov. 2026 0h : semaine 0 des photos
    function LOCK1()  { return 1797029940000; } // 11 déc. 2026 23h59 : « Qui sera là ? »
    function LOCK2()  { return 1801868340000; } // 5 févr. 2027 23h59 : « Ligne de départ » (provisoire)
    function LOCKGP() { return 1807999140000; } // 17 avril 2027 23h59 : Grand Prono
    function nowMs()  { return request.time.toMillis(); }
    function weekNow() {
      let shift = nowMs() >= 1806195600000 ? 3600000 : 0;
      return string(int((nowMs() - T0() + shift) / 604800000));
    }
    function monthNow() {
      let local = request.time + duration.value(nowMs() >= 1806195600000 ? 2 : 1, 'h');
      return string(local.year()) + '-' + (local.month() < 10 ? '0' : '') + string(local.month());
    }
    function candidates() {
      return ['arthaud', 'melenchon', 'roussel', 'tondelier', 'batho', 'glucksmann',
        'hollande', 'bouamrane', 'cazeneuve', 'attal', 'becht', 'philippe', 'bertrand',
        'riner', 'villepin', 'retailleau', 'lisnard', 'nda', 'asselineau', 'philippot',
        'lepen', 'zemmour', 'lassalle', 'polony'];
    }
    function validList(value) {
      return value is list && value.size() > 0 && value.size() <= candidates().size()
        && value.hasOnly(candidates()) && value.toSet().size() == value.size();
    }
    function slot(v) {
      return v is map && v.keys().hasOnly(['id', 'pct']) && v.id in candidates()
        && v.pct is number && v.pct >= 0 && v.pct <= 60;
    }
    function validGrand(v) {
      let t = v.top;
      return v is map && v.keys().hasOnly(['pres', 'top', 'win']) && t is list && t.size() == 5
        && slot(t[0]) && slot(t[1]) && slot(t[2]) && slot(t[3]) && slot(t[4])
        && [t[0].id, t[1].id, t[2].id, t[3].id, t[4].id].toSet().size() == 5
        && t[0].pct >= t[1].pct && t[1].pct >= t[2].pct && t[2].pct >= t[3].pct && t[3].pct >= t[4].pct
        && t[0].pct + t[1].pct + t[2].pct + t[3].pct + t[4].pct <= 100
        && v.pres in [t[0].id, t[1].id] && v.win is number && v.win >= 50 && v.win <= 80;
    }

    function dev() { return /databases/$(db)/documents/devices/$(request.auth.uid); }
    function registered() { return request.auth != null && exists(dev()); }
    function owner(pid) {
      return request.auth != null && exists(dev()) && get(dev()).data.pid == pid;
    }
    function ownerAfter(pid) {
      return request.auth != null && getAfter(dev()) != null && getAfter(dev()).data.pid == pid;
    }
    function validPid(pid) { return pid.matches('^[a-z0-9_-]{2,20}$'); }

    match /players/{pid} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && exists(dev()) && request.query.limit <= 500;
      allow create: if request.auth != null && validPid(pid)
        && request.resource.data.keys().hasOnly(['pseudo', 'createdAt'])
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo.size() >= 2 && request.resource.data.pseudo.size() <= 24
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(db)/documents/secrets/$(pid)) != null;
      allow update, delete: if false;
    }

    match /privateProfiles/{pid} {
      allow get: if owner(pid) || owner('vince');
      allow list: if owner('vince');
      allow create, update: if owner(pid)
        && request.resource.data.keys().hasOnly(['realName'])
        && request.resource.data.realName is string
        && request.resource.data.realName.size() <= 80
        && request.resource.data.realName.matches('(?s).*[^\\s].*');
      allow delete: if owner(pid);
    }

    match /secrets/{pid} {
      allow read: if false;
      allow create: if request.auth != null && validPid(pid)
        && !exists(/databases/$(db)/documents/players/$(pid))
        && request.resource.data.keys().hasOnly(['pin'])
        && request.resource.data.pin is string && request.resource.data.pin.size() == 64;
      allow update, delete: if false;
    }

    match /devices/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pid', 'pin'])
        && getAfter(/databases/$(db)/documents/secrets/$(request.resource.data.pid)) != null
        && getAfter(/databases/$(db)/documents/secrets/$(request.resource.data.pid)).data.pin == request.resource.data.pin;
    }

    match /pronos/{pid} {
      function historyStage(stage, history, previous, value) {
        let next = history.get(stage, {});
        return next is map
          && next.diff(previous.get(stage, {})).affectedKeys().hasOnly([monthNow()])
          && next.get(monthNow(), null) == value && value != null;
      }
      function historyOk(ch) {
        let history = request.resource.data.get('history', {});
        let previous = resource.data.get('history', {});
        let updated = history.diff(previous).affectedKeys();
        return history is map && updated.hasOnly(['l1', 'l2', 'weeks'])
          && (!updated.hasAny(['l1']) || (nowMs() < LOCK1() && ch.hasAny(['l1', 'l1at'])
              && historyStage('l1', history, previous, request.resource.data.l1)))
          && (!updated.hasAny(['l2']) || (nowMs() < LOCK2() && ch.hasAny(['l2', 'l2at'])
              && historyStage('l2', history, previous, request.resource.data.l2)))
          && (!updated.hasAny(['weeks']) || (nowMs() < LOCKGP()
              && historyStage('weeks', history, previous, request.resource.data.weeks.get(weekNow(), null))));
      }
      function changesOk() {
        let ch = request.resource.data.diff(resource.data).affectedKeys();
        return ch.hasOnly(['l1', 'l1at', 'l2', 'l2at', 'weeks', 'team', 'updatedAt', 'history'])
          && (!ch.hasAny(['history']) || historyOk(ch))
          && (!ch.hasAny(['l1', 'l1at']) || nowMs() < LOCK1())
          && (!ch.hasAny(['l2', 'l2at']) || nowMs() < LOCK2())
          && (!ch.hasAny(['weeks']) || (nowMs() < LOCKGP()
                && request.resource.data.weeks.diff(resource.data.weeks).affectedKeys().hasOnly([weekNow()])
                && validGrand(request.resource.data.weeks[weekNow()])))
          && (!ch.hasAny(['l1']) || validList(request.resource.data.l1))
          && (!ch.hasAny(['l2']) || validList(request.resource.data.l2));
      }
      allow read: if registered();
      allow create: if ownerAfter(pid)
        && request.resource.data.keys().hasOnly(['weeks', 'updatedAt'])
        && request.resource.data.weeks.size() == 0
        && request.resource.data.updatedAt == request.time;
      allow update: if owner(pid)
        && request.resource.data.updatedAt == request.time
        && changesOk();
      allow delete: if false;

    }

    function validCode(code) { return code.matches('^[a-f0-9]{32}$'); }
    function inside(code) {
      return request.auth != null && exists(dev())
        && exists(/databases/$(db)/documents/groups/$(code)/members/$(get(dev()).data.pid));
    }
    function groupDoc(code) { return /databases/$(db)/documents/groups/$(code); }

    // Le document unique empêche les votes multiples, même depuis deux appareils.
    // Aucun compteur n'est modifiable : les points se calculent à partir des bulletins.
    match /teamVotes/{ballot} {
      function currentTeam(team) {
        let saved = /databases/$(db)/documents/pronos/$(team);
        let legacy = /databases/$(db)/documents/groups/e1ec7100202700000000000000000001/teams/$(team);
        return exists(saved) && get(saved).data.keys().hasAny(['team'])
          ? get(saved).data.team : (exists(legacy) ? get(legacy).data.value : null);
      }
      function validVote() {
        let v = request.resource.data;
        return v.keys().hasOnly(['team', 'voter', 'rating', 'composition', 'createdAt'])
          && v.rating is int && v.rating >= 1 && v.rating <= 3
          && v.team is string && validPid(v.team) && v.voter is string && owner(v.voter)
          && v.team != v.voter && ballot == v.team + '~' + v.voter
          && exists(/databases/$(db)/documents/players/$(v.team))
          && validTeam(v.composition) && v.composition == currentTeam(v.team)
          && (v.composition.coeur != '' || v.composition.pm != '' || v.composition.min.size() > 0
            || v.composition.jl != '' || v.composition.jn != '')
          && v.createdAt == request.time;
      }
      allow read: if registered();
      allow create, update: if validVote();
      allow delete: if owner(resource.data.voter);
    }

    match /players/{pid}/settings/groups {
      allow get: if owner(pid);
      allow create, update: if owner(pid)
        && request.resource.data.keys().hasOnly(['groups'])
        && request.resource.data.groups is map && request.resource.data.groups.size() <= 5;
    }

    match /groups/{code} {
      allow get: if request.auth != null && validCode(code);
      allow create: if validCode(code) && owner(request.resource.data.creator)
        && (code == 'e1ec7100202700000000000000000001' || owner('vince'))
        && request.resource.data.keys().hasOnly(['name', 'creator'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 48;

      match /members/{pid} {
        function validMember() {
          let v = request.resource.data;
          return v.keys().hasOnly(['pseudo', 'shared', 'submitted'])
            && v.shared is bool && v.submitted is list && v.submitted.size() <= 3
            && v.submitted.hasOnly(['l1', 'l2', 'weeks'])
            && (v.shared || v.submitted.size() == 0);
        }
        allow read: if registered();
        allow create: if owner(pid) && validCode(code) && existsAfter(groupDoc(code))
          && validMember() && !request.resource.data.shared
          && request.resource.data.pseudo == get(/databases/$(db)/documents/players/$(pid)).data.pseudo;
        allow update: if owner(pid) && validMember() && request.resource.data.pseudo == resource.data.pseudo;
      }

      match /teams/{team}/comments/{comment} {
        function canSeeTeam() {
          return registered() && (exists(/databases/$(db)/documents/groups/$(code)/teams/$(team))
            || (exists(/databases/$(db)/documents/pronos/$(team))
              && validTeam(get(/databases/$(db)/documents/pronos/$(team)).data.get('team', null))));
        }
        function validComment() {
          let v = request.resource.data;
          return v.keys().hasOnly(['author', 'pseudo', 'text', 'createdAt'])
            && v.author is string && owner(v.author)
            && v.pseudo == get(/databases/$(db)/documents/players/$(v.author)).data.pseudo
            && v.text is string && v.text.size() <= 500 && v.text.matches('(?s).*[^\\s].*')
            && v.createdAt == request.time;
        }
        allow get: if canSeeTeam();
        allow list: if canSeeTeam() && request.query.limit <= 50;
        allow create: if canSeeTeam() && validComment();
        allow delete: if canSeeTeam() && owner(resource.data.author);
      }

      match /{stage}/{pid} {
        function isProno() { return stage in ['l1', 'l2', 'weeks']; }
        function matchingProno() {
          let canonical = getAfter(/databases/$(db)/documents/pronos/$(pid)).data;
          let copy = request.resource.data;
          return copy.keys().hasOnly(['value', 'history', 'at'])
            && copy.value == canonical[stage]
            && (!copy.keys().hasAny(['history']) || copy.history == canonical.get('history', {}).get(stage, null))
            && (!copy.keys().hasAny(['at']) || copy.at == canonical.get(stage + 'at', null));
        }
        allow read: if registered() && (stage == 'teams' || isProno());
        allow create, update: if owner(pid) && inside(code)
          && ((isProno() && matchingProno()) || (stage == 'teams'
              && request.resource.data.keys().hasOnly(['value']) && validTeam(request.resource.data.value)));
        allow delete: if owner(pid) && inside(code) && (isProno() || stage == 'teams');
      }
    }

    function validTeam(t) {
      return t is map && t.keys().hasOnly(['coeur', 'pm', 'min', 'jl', 'jn'])
        && t.coeur is string && t.coeur.size() <= 60
        && t.pm is string && t.pm.size() <= 60
        && t.jl is string && t.jl.size() <= 120
        && t.jn is string && t.jn.size() <= 120
        && t.min is map && t.min.size() <= 10;
    }
  }
}
